{
  "uid": "kafka-connect",
  "title": "CDC · Kafka & Connect",
  "tags": ["cdc", "kafka"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Messages In/s (broker)", "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [ { "refId": "A", "expr": "kafka_server_broker_topic_metrics_messagesinpersec_oneminuterate", "legendFormat": "total" } ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Bytes In/Out por segundo", "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "kafka_server_broker_topic_metrics_bytesinpersec_oneminuterate", "legendFormat": "in" },
        { "refId": "B", "expr": "kafka_server_broker_topic_metrics_bytesoutpersec_oneminuterate", "legendFormat": "out" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Particiones under-replicated / controller activo", "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "kafka_server_replica_manager_underreplicatedpartitions", "legendFormat": "under-replicated" },
        { "refId": "B", "expr": "kafka_controller_activecontrollercount", "legendFormat": "active controller" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Tasks por conector (running)", "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [ { "refId": "A", "expr": "kafka_connect_worker_connector_running_task_count", "legendFormat": "{{connector}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "none" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Rebalances de Connect (total completados)", "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "refId": "A", "expr": "kafka_connect_worker_rebalance_completed_rebalances", "legendFormat": "rebalances" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Heap JVM usado (broker vs connect)", "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "java_lang_memory_heap_memory_usage_used{job=\"kafka\"}", "legendFormat": "kafka" },
        { "refId": "B", "expr": "java_lang_memory_heap_memory_usage_used{job=\"connect-jmx\"}", "legendFormat": "connect" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Tamaño de logs por topic (bytes)", "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [ { "refId": "A", "expr": "sum by (topic) (kafka_log_size_bytes) > 0", "legendFormat": "{{topic}}" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    }
  ]
}
