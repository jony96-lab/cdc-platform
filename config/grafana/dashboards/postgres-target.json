{
  "uid": "postgres-target",
  "title": "CDC · PostgreSQL Destino",
  "tags": ["cdc", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "PostgreSQL UP", "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [ { "refId": "A", "expr": "pg_up", "legendFormat": "up" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Backends (conexiones)", "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(pg_stat_database_numbackends{datname=\"cdc_target\"})", "legendFormat": "backends" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 50 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Tamaño BD cdc_target", "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 7, "x": 9, "y": 0 },
      "targets": [ { "refId": "A", "expr": "pg_database_size_bytes{datname=\"cdc_target\"}", "legendFormat": "size" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Cache hit ratio", "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"cdc_target\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"cdc_target\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"cdc_target\"}[5m])) + 0.0001)", "legendFormat": "hit ratio" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Tuplas insert/update/delete/s en cdc_target (efecto del sink JDBC)", "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "rate(pg_stat_database_tup_inserted{datname=\"cdc_target\"}[5m])", "legendFormat": "inserted/s" },
        { "refId": "B", "expr": "rate(pg_stat_database_tup_updated{datname=\"cdc_target\"}[5m])", "legendFormat": "updated/s" },
        { "refId": "C", "expr": "rate(pg_stat_database_tup_deleted{datname=\"cdc_target\"}[5m])", "legendFormat": "deleted/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Transacciones commit/s", "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "refId": "A", "expr": "rate(pg_stat_database_xact_commit{datname=\"cdc_target\"}[5m])", "legendFormat": "commits/s" } ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Deadlocks y conflictos", "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "rate(pg_stat_database_deadlocks{datname=\"cdc_target\"}[5m])", "legendFormat": "deadlocks/s" },
        { "refId": "B", "expr": "rate(pg_stat_database_temp_bytes{datname=\"cdc_target\"}[5m])", "legendFormat": "temp bytes/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
