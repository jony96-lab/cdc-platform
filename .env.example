# ==============================================================
# CDC Platform - Configuracion de entorno
# Copiar a .env y completar las contraseñas de administrador.
# .env NUNCA se commitea (esta en .gitignore).
# ==============================================================

# ---------- COMPLETAR (obligatorio, modo host) ----------
# Contrasena del root de tu MySQL local (servicio MySQL80, puerto 3306)
MYSQL_ROOT_PASSWORD=admin
# Superusuario de tu PostgreSQL local (servicio PostgreSQL_Data_D, puerto 5433)
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=admin

# ---------- Topologia ----------
# host = usa las BDs instaladas en Windows (MySQL80 / PostgreSQL_Data_D)
# container = usa las BDs del overlay docker-compose.demodb.yml (perfil demodb)
DB_MODE=host

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
PG_HOST=host.docker.internal
PG_PORT=5433
PG_TARGET_DB=cdc_target

# ---------- Credenciales CDC (generadas por gen-secrets, no tocar) ----------
MYSQL_CDC_USER=cdc_user
MYSQL_CDC_PASSWORD=
MYSQL_APP_USER=demo_app
MYSQL_APP_PASSWORD=
PG_CDC_ROLE=cdc_role
PG_CDC_PASSWORD=

# ---------- Pipeline demo ----------
CDC_TOPIC_PREFIX=cdc
CDC_SOURCE_DB=inventory
MYSQL_SOURCE_SERVER_ID=5401
DEMO_DB_ROOT_PASSWORD=

# ---------- SQL Server (opcional: listo para futuras implementaciones) ----------
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=1433
SQLSERVER_CDC_USER=cdc_user
SQLSERVER_CDC_PASSWORD=
SQLSERVER_APP_USER=demo_app
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# SA password del SQL Server del perfil "sqlserver" (demodb).
# Requisito SQL Server: >=8 chars, mayuscula+minuscula+digito+simbolo
SQLSERVER_SA_PASSWORD=

# ---------- Imágenes de la plataforma ----------
# Por defecto se BUILDEAN en el primer up (build from source).
# Modo pre-buildeado (sin compilar nada): descomentar y apuntar al registry
# de tu organización (ej. ghcr.io/<org>/...):
# CDC_KAFKA_IMAGE=ghcr.io/jony96-lab/cdc-kafka:4.3.1
# CDC_CONNECT_IMAGE=ghcr.io/jony96-lab/cdc-connect:3.6.2
# CDC_PORTAL_IMAGE=ghcr.io/jony96-lab/cdc-portal:1.0
# CDC_TESTER_IMAGE=ghcr.io/jony96-lab/cdc-tester:1.0

# ---------- Versiones de imagenes (verificadas 2026-09) ----------
KAFKA_IMAGE=apache/kafka:4.3.1
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.6.2.Final
DBZ_JDBC_PLUGIN_VERSION=3.6.2.Final
JMX_EXPORTER_VERSION=1.0.1
KAFBAT_IMAGE=kafbat/kafka-ui:v1.5.0
PROM_IMAGE=prom/prometheus:v3.13.3
GRAFANA_IMAGE=grafana/grafana:13.0.8
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.0
MYSQLD_EXPORTER_IMAGE=prom/mysqld-exporter:v0.20.0
PG_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.20.1
CURL_IMAGE=curlimages/curl:8.22.0
PYTHON_IMAGE=python:3.12-slim
# ID estable del cluster KRaft (22 chars base64url). Genera uno con:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# ---------- Puertos expuestos al host ----------
PORTAL_PORT=8085
KAFBAT_PORT=8080
CONNECT_PORT=8083
KAFKA_EXTERNAL_PORT=9092
PROM_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------- Lakehouse (CDC -> Parquet/Iceberg en MinIO) ----------
# Origen parametrizable del lakehouse: mysql | postgres
# LH_SOURCE_DB vacio reutiliza CDC_SOURCE_DB
LH_SOURCE_ENGINE=mysql
LH_SOURCE_DB=
LH_CATALOG_DB=iceberg_catalog
LH_MINIO_ROOT_USER=lhadmin
LH_MINIO_ROOT_PASSWORD=

# ---------- Alertas por email ----------
# Gmail: activa 2FA y genera app-password en https://myaccount.google.com/apppasswords
# ALERT_EMAIL_ENABLED=false deshabilita el email (quedan solo las alertas en el Portal)
ALERT_EMAIL_ENABLED=true
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_FROM=tu-cuenta@gmail.com
ALERT_SMTP_USER=tu-cuenta@gmail.com
ALERT_SMTP_PASSWORD=app-password-de-16-caracteres
ALERT_EMAIL_TO=destino1@dominio.com,destino2@dominio.com

# ---------- URLs externas (vistas desde TU navegador) ----------
GRAFANA_EXT_URL=http://localhost:3000
KAFBAT_EXT_URL=http://localhost:8080
CONNECT_EXT_URL=http://localhost:8083
PROM_EXT_URL=http://localhost:9090
